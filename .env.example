# Скопируйте в .env и заполните значения
# cp .env.example .env

# Google Sheets (обязательно)
GOOGLE_CREDENTIALS_JSON='{"type":"service_account",...}'

# GigaChat — для AI-рекомендаций и чата
GIGACHAT_CLIENT_ID="ваш-client-id"
GIGACHAT_CLIENT_SECRET="ваш-client-secret"

# Или готовый Base64 ключ (ClientID:ClientSecret)
# GIGACHAT_AUTH_KEY="YjZmOWM1YWMt..."

# Yandex Vision — для распознавания бланков (OCR)
# YANDEX_VISION_API_KEY="ваш-api-ключ"
# YANDEX_VISION_IAM_TOKEN="..."  # альтернатива API key
# YANDEX_VISION_FOLDER_ID="..."   # при IAM-токене

# Опционально (если другие URL)
# GIGACHAT_API_URL="https://gigachat.devices.sberbank.ru/api/v1/chat/completions"
# GIGACHAT_AUTH_URL="https://ngw.devices.sberbank.ru:9443/api/v2/oauth"
# GIGACHAT_SCOPE="GIGACHAT_API_PERS"
