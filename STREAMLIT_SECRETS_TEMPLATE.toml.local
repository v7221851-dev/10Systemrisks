# ============================================
# ШАБЛОН СЕКРЕТОВ ДЛЯ STREAMLIT CLOUD
# Скопируйте всё ниже в Settings → Secrets на share.streamlit.io
# ============================================

# ============================================
# ОБЯЗАТЕЛЬНО: Google Sheets (для загрузки данных)
# ============================================
# Запустите: python3 export_google_credentials_secret.py
# Скопируйте выведенную строку и вставьте ниже:
GOOGLE_CREDENTIALS_JSON = '<вставьте JSON из export_google_credentials_secret.py>'

# ============================================
# GigaChat (AI-рекомендации) - из .streamlit/secrets.toml
# ============================================
GIGACHAT_CLIENT_ID = "<ваш_client_id>"
GIGACHAT_CLIENT_SECRET = "<ваш_client_secret>"
GIGACHAT_SCOPE = "GIGACHAT_API_PERS"
GIGACHAT_AUTH_KEY = "<ваш_auth_key>"
GIGACHAT_API_URL = "https://gigachat.devices.sberbank.ru/api/v1/chat/completions"
GIGACHAT_AUTH_URL = "https://ngw.devices.sberbank.ru:9443/api/v2/oauth"

# ============================================
# Yandex Vision (OCR по фото) - из .streamlit/secrets.toml
# ============================================
YANDEX_VISION_API_KEY = "<ваш_yandex_api_key>"

# ============================================
# Опционально: Настройки промпта GigaChat (если хотите изменить)
# ============================================
# GIGACHAT_SYSTEM_ROLE = "Ты эксперт по превентивной медицине и здоровому образу жизни."
# GIGACHAT_PROMPT_STYLE = "практичный, мотивирующий"
# GIGACHAT_MAX_WORDS = 200
# GIGACHAT_PROMPT_TONE = "дружелюбный, поддерживающий"
# GIGACHAT_FOCUS_AREAS = "образ жизни, питание, физическая активность, сон, управление стрессом"
# GIGACHAT_RESTRICTIONS = "Не назначай лекарства и не стави диагнозы. Фокусируйся на профилактике и образе жизни."
