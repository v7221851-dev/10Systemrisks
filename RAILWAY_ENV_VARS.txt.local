# ⚠️ ВНИМАНИЕ: Этот файл содержит секреты!
# НЕ коммитьте этот файл в Git!
# Используйте его только локально для копирования значений в Railway

# Переменные окружения для Railway
# Скопируйте эти значения в Railway → Settings → Variables
# Для GOOGLE_CREDENTIALS_JSON запустите: python3 export_google_credentials_secret.py

GOOGLE_CREDENTIALS_JSON=<вставьте JSON из export_google_credentials_secret.py>

GIGACHAT_CLIENT_ID=<ваш_client_id>
GIGACHAT_CLIENT_SECRET=<ваш_client_secret>
GIGACHAT_AUTH_KEY=<ваш_auth_key>
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

YANDEX_VISION_API_KEY=<ваш_yandex_api_key>
